<!-- GTA V PS4 Custom Handling Meta (Chaos & High Speed Edition) -->
<!-- Injected into update.rpf / common / data / handling.meta -->
<CHandlingDataMgr>
  <HandlingData>
    <!-- Template: Sports/Supercar High-Performance & Drift Handling -->
    <Item type="CHandlingData">
      <handlingName>DEFAULT_SPORTS_BOOST</handlingName>
      <fMass value="1400.000000" />
